{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:401202591305:log-group:/aws/lambda/mxintech-website-contact-form-handler:*"
    },
    {
      "Sid": "ContactSubmissionsTableReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:401202591305:table/mxintech-website-contact-submissions",
        "arn:aws:dynamodb:us-east-1:401202591305:table/mxintech-website-contact-submissions/index/*"
      ]
    },
    {
      "Sid": "ContactVerificationTokensTableReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:401202591305:table/mxintech-website-contact-verification-tokens"
    },
    {
      "Sid": "SesSendContactEmails",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-1:401202591305:identity/mxintech.org"
    }
  ]
}
